    {
      "name": "Clasificación (éxito)",
      "item": [
        {
          "name": "Texto benigno (EN)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"sin trazas ni rutas\", () => pm.expect(pm.response.text()).to.not.match(/Exception|at com\\.|\\/Users\\/|\\/app\\//));",
                  "const j = pm.response.json();",
                  "pm.test(\"modelo\", () => pm.expect(j.model).to.eql(\"multilingual-toxicity-small\"));",
                  "pm.test(\"7 categorías en orden\", () => pm.expect(Object.keys(j.scores)).to.eql([\"toxicity\", \"severe_toxicity\", \"obscene\", \"threat\", \"insult\", \"identity_attack\", \"sexual_explicit\"]));",
                  "pm.test(\"valores finitos en [0,1]\", () => Object.values(j.scores).forEach(v => pm.expect(v).to.be.within(0, 1)));",
                  "pm.test(\"toxicity baja\", () => pm.expect(j.scores.toxicity).to.be.below(0.3));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
